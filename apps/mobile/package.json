{
  "name": "@satzio/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "SATZIO native Apps (Android & iOS) via Capacitor – verpackt die Web-App aus apps/web",
  "scripts": {
    "build:web": "VITE_API_URL=${SATZIO_API_URL:-https://satzio.netfusion-service.de} pnpm --filter @satzio/web exec vite build",
    "sync": "cap sync",
    "build": "pnpm run build:web && cap sync",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor '#0B0F0E' --iconBackgroundColorDark '#0B0F0E' --splashBackgroundColor '#0B0F0E' --splashBackgroundColorDark '#0B0F0E'",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "android:apk": "pnpm run build && cd android && ./gradlew assembleDebug && mkdir -p ../dist && cp app/build/outputs/apk/debug/app-debug.apk ../dist/satzio-debug.apk",
    "android:release": "pnpm run build && cd android && ./gradlew assembleRelease bundleRelease",
    "ios:open": "cap open ios",
    "ios:sync": "pnpm run build:web && cap sync ios && node scripts/vendor-ios.mjs",
    "ios:vendor": "node scripts/vendor-ios.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "7.1.0",
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.9",
    "@capacitor/haptics": "7.0.5",
    "@capacitor/ios": "7.6.9",
    "@capacitor/keyboard": "7.0.6",
    "@capacitor/local-notifications": "7.0.7",
    "@capacitor/preferences": "7.0.4",
    "@capacitor/splash-screen": "7.0.5",
    "@capacitor/status-bar": "7.0.6"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "7.6.9",
    "typescript": "5.9.3"
  }
}
