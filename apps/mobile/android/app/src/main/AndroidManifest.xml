<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Pausentimer: lokale Benachrichtigung zur exakten Endzeit (auch bei gesperrtem Gerät).
         POST_NOTIFICATIONS (Android 13+), WAKE_LOCK und RECEIVE_BOOT_COMPLETED bringt
         @capacitor/local-notifications per Manifest-Merge mit; Abfrage erfolgt beim ersten Timer.
         SCHEDULE_EXACT_ALARM statt USE_EXACT_ALARM (Letzteres ist laut Play-Richtlinie Wecker-/Kalender-Apps vorbehalten);
         ohne Freigabe fällt das Plugin auf setAndAllowWhileIdle zurück. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Display während des Trainings anlassen (@capacitor-community/keep-awake) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>
