<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/satzio_bg</item>
        <item name="colorPrimaryDark">@color/satzio_bg</item>
        <item name="colorAccent">@color/satzio_neon</item>
        <item name="android:windowBackground">@color/satzio_bg</item>
        <item name="android:statusBarColor">@color/satzio_bg</item>
        <item name="android:navigationBarColor">@color/satzio_navbar</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="colorAccent">@color/satzio_neon</item>
        <item name="android:windowBackground">@color/satzio_bg</item>
        <item name="android:statusBarColor">@color/satzio_bg</item>
        <!-- Farbe der Material-3-Navigationsleiste der Web-App (surface-container) -->
        <item name="android:navigationBarColor">@color/satzio_navbar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>