# ─────────────────────────────── SATZIO Konfiguration ───────────────────────────────
# Kopiere diese Datei nach .env – oder führe ./scripts/setup.sh aus, das fehlende
# Secrets automatisch und sicher erzeugt. Niemals echte Secrets ins Git-Repository!

# Öffentliche Adresse, unter der SATZIO erreichbar ist (für E-Mail-Links & Cookies).
# Lokal: http://localhost:8080 · Produktion: https://satzio.example.com
PUBLIC_URL=http://localhost:8080

# Port & Bind-Adresse der Web-App auf dem Host
WEB_PORT=8080
WEB_BIND=0.0.0.0

# Datenbank (läuft nur intern im Docker-Netzwerk)
POSTGRES_DB=satzio
POSTGRES_USER=satzio
POSTGRES_PASSWORD=

# Signaturschlüssel für Access-Tokens (mind. 32 Zeichen, zufällig)
JWT_ACCESS_SECRET=

# Neue Konten direkt in der App erlauben (true/false)
REGISTRATION_ENABLED=true

# Secure-Cookies erzwingen (leer = automatisch true bei https:// in PUBLIC_URL)
COOKIE_SECURE=

# Zusätzliche erlaubte Origins (kommagetrennt), z. B. für eine separat gehostete Web-App
CORS_ORIGINS=

# E-Mail-Versand (Verifizierung, Passwort-Reset). Leer = deaktiviert.
# Entwicklung: docker compose --profile dev up → SMTP_HOST=mailpit, SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SATZIO <no-reply@satzio.local>"
# Nur Entwicklung: Links zusätzlich ins API-Log schreiben, wenn kein SMTP gesetzt ist
MAIL_LOG_LINKS=false

# Schutz vor Missbrauch
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10

# API-Dokumentation unter /api/docs
SWAGGER_ENABLED=true
